# REGGAETON EL REAL - Azure App Service Linux / PHP routing and hardening
#
# Azure App Service PHP on Linux uses NGINX, so .htaccess is NOT used there.
# When we deploy, these rules must be merged into the active NGINX server{}
# configuration before reloading NGINX.
#
# IMPORTANT: keep the security regex locations above the generic PHP handler.
# Do NOT activate this example file locally.
#
# Security Fase 6 response headers, CSP Report-Only and production-only HSTS
# are emitted centrally by security-bootstrap.php for PHP responses. If the
# production edge serves static documents directly, mirror the same headers at
# the TLS/edge layer there; never enable HSTS on a plain-HTTP/local listener.

# Runtime secrets, source helpers and database migrations are never public.
location ~* ^/(?:env(?:\.[^/]+)?\.php|dbcon\.php|config\.php|admin-auth\.php|admin-upload-security\.php|public-request-security\.php|security-bootstrap\.php)$ {
    return 404;
}

location ~* ^/(?:database|\.git)(?:/|$) {
    return 404;
}

# Hide dot-files except ACME /.well-known challenges.
location ~ (^|/)\.(?!well-known(?:/|$)) {
    return 404;
}

# Common backup/source artifacts must not be downloadable.
location ~* \.(?:sql|log|bak|backup|old|orig|save|swp|zip|tar|gz|7z)$ {
    return 404;
}

# /pictures contains public media only. Never pass executable-looking files
# from this directory to PHP/CGI or another interpreter.
location ~* ^/pictures/.*\.(?:php[0-9]?|phtml|pht|phar|cgi|pl|py|sh)$ {
    return 404;
}

location ~ ^/cd/([a-z0-9-]+)/?$ {
    rewrite ^/cd/([a-z0-9-]+)/?$ /product.php?slug=$1 last;
}

location ~ ^/artista/([a-z0-9-]+)/?$ {
    rewrite ^/artista/([a-z0-9-]+)/?$ /artist.php?slug=$1 last;
}

location = /sitemap.xml {
    rewrite ^/sitemap\.xml$ /sitemap.php last;
}
