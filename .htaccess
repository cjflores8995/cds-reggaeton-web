Options -MultiViews -Indexes

RewriteEngine On

# Security Fase 3/6/7 + Admin/System Logs - deny direct web access to
# runtime/source files and common backup artifacts. Server-side require/include
# continues to work.
RewriteRule ^(?:env(?:\.[^/]+)?\.php|dbcon\.php|config\.php|admin-auth\.php|admin-system-log\.php|admin-cd-audit\.php|admin-image-audit\.php|admin-artist-settings-audit\.php|admin-upload-security\.php|public-request-security\.php|security-bootstrap\.php|functions\.php|uilang\.php|thumbnailgenerator\.php|artistshelper\.php|slughelper\.php|productimages\.php|seo\.php)$ - [F,L,NC]
RewriteRule ^(?:database|\.git)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule \.(?:sql|log|bak|backup|old|orig|save|swp|zip|tar|gz|7z)$ - [F,L,NC]

# Uploaded files are public media, never executable server-side code.
RewriteRule ^pictures/.*\.(?:php[0-9]?|phtml|pht|phar|cgi|pl|py|sh)$ - [F,L,NC]

# Public clean URLs. The route wrappers add lightweight analytics for 404s
# before delegating to the existing product/artist pages.
RewriteRule ^cd/([a-z0-9-]+)/?$ product-route.php?slug=$1 [L,QSA,NC]
RewriteRule ^artista/([a-z0-9-]+)/?$ artist-route.php?slug=$1 [L,QSA,NC]

# Cleaner sitemap endpoint.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA,NC]

# Human-facing clean URLs that do not exist. Missing assets keep the normal
# web-server 404 and do not generate customer analytics noise.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$ [NC]
RewriteRule ^ not-found.php [L,QSA]
